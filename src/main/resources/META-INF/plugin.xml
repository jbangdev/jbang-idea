<idea-plugin>
    <id>dev.jbang.intellij.JBangPlugin</id>
    <name>JBang</name>
    <vendor email="max@jbang.dev" url="https://www.jbang.dev/">jbangdev</vendor>
    <category>Build Tools</category>

    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>org.jetbrains.idea.reposearch</depends>

    <!-- Optional language support — same classes, just registered for each language -->
    <depends optional="true" config-file="jbang-withKotlin.xml">org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="jbang-withGroovy.xml">org.intellij.groovy</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <description><![CDATA[
    <p><b>JBang plugin</b> integrates <a href="https://www.jbang.dev/">JBang</a> into IntelliJ IDEA.</p>
    <ul>
      <li>Auto-sync: resolves classpath from jbang directives on save</li>
      <li>Run & debug jbang scripts with gutter icons and run configurations</li>
      <li>Directive completion and syntax highlighting</li>
      <li>Coexists with Gradle/Maven projects</li>
      <li>JSON Schema for jbang-catalog.json</li>
    </ul>
    ]]></description>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Project model: auto-sync and classpath -->
        <backgroundPostStartupActivity implementation="dev.jbang.idea.project.JBangStartupActivity"/>
        <additionalLibraryRootsProvider implementation="dev.jbang.idea.project.JBangLibraryProvider"/>
        <resolveScopeEnlarger implementation="dev.jbang.idea.project.JBangResolveScopeEnlarger"/>
        <java.elementFinder implementation="dev.jbang.idea.project.JBangSourceElementFinder"/>

        <!-- File detection -->
        <fileIconProvider implementation="dev.jbang.idea.JBangIconProvider"/>
        <fileType implementationClass="dev.jbang.idea.JBangFileType" name="JBang"
            fieldName="INSTANCE" extensions="jbang"/>
        <fileType name="JSHELL" language="JShellLanguage" extensions="jsh"/>
        <fileType name="JSON5" fileNames="jbang-catalog.json"/>

        <!-- Completion: directives and GAV (one class each, registered per language) -->
        <completion.contributor language="JAVA"
            implementationClass="dev.jbang.idea.completion.DirectiveCompletion"/>
        <completion.contributor language="JAVA"
            implementationClass="dev.jbang.idea.completion.GavCompletion"/>
        <completion.contributor language="JAVA"
            implementationClass="dev.jbang.idea.completion.PathCompletion"/>
        <completion.contributor language="JSON"
            implementationClass="dev.jbang.idea.completion.CatalogCompletion"/>
        <completion.contributor language="JSON5"
            implementationClass="dev.jbang.idea.completion.CatalogCompletion"/>

        <!-- Navigation for //SOURCES, //FILES, and catalog script-ref -->
        <psi.referenceContributor language="JAVA"
            implementation="dev.jbang.idea.navigation.JBangNavigation"/>
        <psi.referenceContributor language="JSON"
            implementation="dev.jbang.idea.navigation.JBangNavigation"/>
        <psi.referenceContributor language="JSON5"
            implementation="dev.jbang.idea.navigation.JBangNavigation"/>

        <!-- Syntax highlighting -->
        <annotator language="JAVA"
            implementationClass="dev.jbang.idea.highlight.JBangDirectiveAnnotator"/>

        <!-- Run configurations -->
        <configurationType implementation="dev.jbang.idea.run.JBangConfigurationType"/>
        <runConfigurationProducer implementation="dev.jbang.idea.run.JBangRunConfigProducer"/>
        <programRunner implementation="dev.jbang.idea.run.JBangProgramRunner"/>
        <runLineMarkerContributor language="JAVA"
            implementationClass="dev.jbang.idea.run.JBangRunLineMarker"/>


        <!-- Status bar widget for active root switching -->
        <statusBarWidgetFactory id="JBangActiveRoot"
            implementation="dev.jbang.idea.project.JBangStatusBarWidgetFactory"/>

        <!-- Settings -->
        <applicationConfigurable parentId="tools"
            instance="dev.jbang.idea.settings.JBangConfigurable"
            id="dev.jbang.intellij.JBangConfigurable"
            displayName="JBang"/>
        <applicationService serviceImplementation="dev.jbang.idea.settings.JBangSettings"/>

        <!-- Notifications -->
        <notificationGroup id="JBang" icon="/icons/jbang-16x16.png"
            displayType="BALLOON" isLogByDefault="true"/>
    </extensions>

    <extensions defaultExtensionNs="JavaScript">
        <JsonSchema.ProviderFactory
            implementation="dev.jbang.idea.JBangCatalogJsonSchemaProviderFactory"/>
    </extensions>

    <actions>
        <action id="jbang.CreateScript"
                class="dev.jbang.idea.JBangCreateScriptAction"
                text="JBang Script"
                icon="/icons/jbang-16x16.png">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
        <action id="jbang.Sync"
                class="dev.jbang.idea.project.JBangSyncAction"
                text="Sync JBang Project"
                icon="AllIcons.Actions.Refresh">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
        </action>
        <action id="jbang.RunScript"
                class="dev.jbang.idea.run.JBangRunScriptAction"
                text="Run with JBang"
                icon="/icons/jbang-16x16.png">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
        </action>
        <action id="jbang.DebugScript"
                class="dev.jbang.idea.run.JBangDebugScriptAction"
                text="Debug with JBang"
                icon="/icons/jbang-16x16.png">
            <add-to-group group-id="EditorPopupMenu" relative-to-action="jbang.RunScript" anchor="after"/>
            <add-to-group group-id="ProjectViewPopupMenu" relative-to-action="jbang.RunScript" anchor="after"/>
        </action>
    </actions>

    <projectListeners>
        <listener class="dev.jbang.idea.project.JBangFileListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="dev.jbang.idea.project.JBangEditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
