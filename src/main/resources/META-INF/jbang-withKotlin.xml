<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <completion.contributor language="kotlin"
            implementationClass="dev.jbang.idea.completion.DirectiveCompletion"/>
        <completion.contributor language="kotlin"
            implementationClass="dev.jbang.idea.completion.GavCompletion"/>
        <completion.contributor language="kotlin"
            implementationClass="dev.jbang.idea.completion.PathCompletion"/>
        <psi.referenceContributor language="kotlin"
            implementation="dev.jbang.idea.navigation.JBangNavigation"/>
        <runLineMarkerContributor language="kotlin"
            implementationClass="dev.jbang.idea.run.JBangRunLineMarker"/>
        <annotator language="kotlin"
            implementationClass="dev.jbang.idea.highlight.JBangDirectiveAnnotator"/>
    </extensions>
</idea-plugin>
